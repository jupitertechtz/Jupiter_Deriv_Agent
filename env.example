# Deriv API token: use your DEMO (VRTC...) account token, scopes Read + Trade
DERIV_API_TOKEN=
# Register your own app at Deriv's API dashboard; 1089 is Deriv's public testing app_id
DERIV_APP_ID=1089
# DERIV_WS_URL=wss://ws.derivws.com/websockets/v3

SYMBOLS=R_100
STAKE=0.5
CURRENCY=USD
STRATEGY=coldest           # coldest | hottest | repeat_last | random
ANALYSIS_WINDOW=500
TRADE_EVERY_N_TICKS=10

# Risk controls
MAX_DAILY_LOSS=5
SESSION_TAKE_PROFIT=0      # 0 = off
MAX_TRADES_PER_SESSION=100
MAX_CONSECUTIVE_LOSSES=25
MAX_CONSECUTIVE_ERRORS=5

TRADE_LOG=trades.csv

# Leave blank. Real-money accounts are refused unless this is set to the exact phrase in config.py.
LIVE_TRADING_CONFIRM=

# Web / Vercel
SESSION_KEY=               # long random string; required to start sessions or view results
CRON_SECRET=               # optional; enables /api/cron for scheduled sessions
SESSION_MAX_TRADES=10      # trades per web run (max 50)
SESSION_TIME_BUDGET=50     # seconds per run; keep below the function timeout
SESSION_TRADE_EVERY_N_TICKS=1

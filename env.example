# NEVER commit real values. On Vercel, set these as Sensitive environment variables instead.
# Personal Access Token (pat_...) from developers.deriv.com with the trade scope
DERIV_API_TOKEN=
# App ID of a PAT-type app registered on developers.deriv.com
DERIV_APP_ID=
ACCOUNT_TYPE=demo          # demo | real (real also needs LIVE_TRADING_CONFIRM)
# DERIV_API_BASE=https://api.derivws.com

SYMBOLS=R_100
STAKE=0.5
CURRENCY=USD
STRATEGY=adaptive          # adaptive | coldest | hottest | repeat_last | random
ANALYSIS_WINDOW=500
TRADE_EVERY_N_TICKS=10

# Risk controls
MAX_DAILY_LOSS=5
SESSION_TAKE_PROFIT=0      # 0 = off
MAX_TRADES_PER_SESSION=100
MAX_CONSECUTIVE_LOSSES=25
MAX_CONSECUTIVE_ERRORS=5

TRADE_LOG=trades.csv

# Leave blank. Real-money accounts are refused unless this is set to the exact phrase in config.py.
LIVE_TRADING_CONFIRM=

# Web / Vercel
# Long random string; required to start sessions or view results
SESSION_KEY=
# Optional; enables /api/cron for scheduled sessions
CRON_SECRET=
SESSION_MAX_TRADES=10      # trades per web run (max 50)
SESSION_TIME_BUDGET=50     # seconds per run; keep below the function timeout
SESSION_TRADE_EVERY_N_TICKS=1

# Adaptive Digit Engine v2 (strategy "adaptive"). Strict by design: loosening these makes it trade on noise.
ADAPTIVE_HISTORY=3000          # warm-up ticks per market
ADAPTIVE_MIN_SAMPLES=1000      # walk-forward predictions required
ADAPTIVE_MAX_P=0.01            # accuracy must be this unlikely to be luck
ADAPTIVE_MIN_EDGE=0.02         # model probability must beat 10% by this much
ADAPTIVE_MIN_SEPARATION=0.005  # lead over the second-best digit
ADAPTIVE_MAX_ENTROPY=0.99      # forecast entropy at/above this = uniform -> SKIP
ADAPTIVE_PERSISTENCE=30        # consecutive ticks the gate must hold before MATCH
ADAPTIVE_ETA=0.1               # how fast model weights adapt
